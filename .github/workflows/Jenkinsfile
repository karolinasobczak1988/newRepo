pipeline { 
    agent any
    environment {
        GIT_CREDENTIALS = credentials('ssh-ed25519')  // Using SSH credentials for Git
    }
    stages {
        stage('Checkout') {
            steps {
                git(
                    url: 'git@github.com:karolinasobczak1988/newRepo.git',
                    credentialsId: 'ssh-ed25519'
                )
            }
        }
        stage('Install Dependencies') {
            steps {
                sh 'npm install'  // Install all dependencies
            }
        }
        stage('Compile TypeScript') {
            steps {
                sh 'npx tsc' // Compile TypeScript → JavaScript in "src/compile"
            }
        }
        stage('Run Playwright Tests') {
            steps {
                script {
                    sh 'npx playwright install'  // Ensure Playwright dependencies are installed
                    sh 'npx playwright test src/compile/' // Run tests from compiled JS
                }
            }
        }
    }
}
