{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "outDir": "./src/compile",  // ✅ Ensure compiled files go here
    "rootDir": "./src",         // ✅ Ensure TypeScript reads from src/
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedParameters": false,
    "noUnusedLocals": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
